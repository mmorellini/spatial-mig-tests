country_legend <- data.frame(unique(obs_student_flow$from),
unique(obs_student_flow$from_name)) %>%
rename(from = 1,
from_name = 2) %>%
mutate_all(as.character) %>%
unite(collapse, from, from_name,  remove = FALSE, sep = " = ") %>%
mutate(collapse = paste0(collapse, ","))
library(tidyr)
country_legend <- data.frame(unique(obs_student_flow$from),
unique(obs_student_flow$from_name)) %>%
rename(from = 1,
from_name = 2) %>%
mutate_all(as.character) %>%
unite(collapse, from, from_name,  remove = FALSE, sep = " = ") %>%
mutate(collapse = paste0(collapse, ","))
country_legend$collapse[country_legend$from == "TUR"] <- "TUR = Turkey."
p_heat <- ggplot(data = obs_student_flow,
aes(x = to,
y = forcats::fct_rev(from),
fill = as.numeric(weight))) +
geom_raster() +
labs(title = "Observed student migration flows (raw count)",
x = "Country of destination",
y = "Country of origin",
fill = "Mobile students counts") +
scale_x_discrete(position = "top", guide = guide_axis(n.dodge = 2)) +
scale_y_discrete(guide = guide_axis(n.dodge = 2))
p_heat + annotate(paste0("Country legend: ",
paste(country_legend$collapse, collapse = " ")),
x = 0,
y = -1)
paste0("Country legend: ",
paste(country_legend$collapse, collapse = " "))
element_custom <- function() {
structure(list(), class = c("element_custom", "element_text"))
}
element_grob.element_custom <- function(element, label="", ...)  {
disect <- strsplit(label, "\\n")[[1]]
labels <- lapply(disect, function(x) tryCatch(parse(text=x),
error = function(e) x))
hl <-  unit(rep(1, length(labels)), 'strheight', data=labels) + unit(0.1,"line")
yl <- c(list(unit(0,"line")),
lapply(seq_along(labels[-length(labels)]), function(ii) sum(hl[1:ii])))
cl <- do.call(gList, Map(function(label, ii)
textGrob(label, y = unit(1,"npc")-yl[[ii]], hjust=0, x=0, vjust=1),
label = labels, ii = seq_along(labels)))
gTree(children = cl, cl="sl", heights = hl, gp=gpar(col="grey50",fontsize=8))
}
heightDetails.sl <- function(x) sum(x$heights)
p_heat +
labs(caption = paste0("~bold('Country legend: ')", "\n",
paste(country_legend$collapse, collapse = " ") ))
